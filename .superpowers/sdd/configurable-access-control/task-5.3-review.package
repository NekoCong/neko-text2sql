@@ -0,0 +1,28 @@
+package com.nekocong.text2sql.access.api.dto;
+
+/**
+ * Request body for upserting one data-scope rule.
+ *
+ * <p>The rule is identified by ({@code roleId}, {@code datasourceId}, {@code tableName}): sending it
+ * again updates that table's policy instead of creating a second row. There is deliberately no
+ * predicate field — a policy can only reference a validated column and one entry of the closed
+ * {@code PrincipalAttribute} catalog, never raw SQL.
+ *
+ * <p>{@code FILTER} requires both {@code columnName} and {@code principalAttribute}; {@code ALL} and
+ * {@code DENY} must carry neither.
+ *
+ * @param roleId the owning role id (required)
+ * @param datasourceId the datasource id (required; must exist in the registry)
+ * @param tableName the table name (required; must exist in the datasource's live metadata)
+ * @param policy one of {@code ALL}, {@code FILTER}, {@code DENY} (required)
+ * @param columnName the filtered column, required for {@code FILTER} and forbidden otherwise
+ * @param principalAttribute the principal attribute code, required for {@code FILTER} and forbidden
+ *     otherwise
+ */
+public record DataScopeRequest(
+        String roleId,
+        String datasourceId,
+        String tableName,
+        String policy,
+        String columnName,
+        String principalAttribute) {}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DataScopeView.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DataScopeView.java
new file mode 100644
index 0000000..a8b45db
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DataScopeView.java
@@ -0,0 +1,42 @@
+package com.nekocong.text2sql.access.api.dto;
+
+import com.nekocong.text2sql.access.DataScopeRule;
+
+/**
+ * A data-scope rule as returned to clients.
+ *
+ * @param id the rule id
+ * @param roleId the owning role id
+ * @param datasourceId the datasource id
+ * @param tableName the table name
+ * @param policy one of {@code ALL}, {@code FILTER}, {@code DENY}
+ * @param columnName the filtered column, or {@code null} for {@code ALL}/{@code DENY}
+ * @param principalAttribute the principal attribute code, or {@code null} for
+ *     {@code ALL}/{@code DENY}
+ */
+public record DataScopeView(
+        String id,
+        String roleId,
+        String datasourceId,
+        String tableName,
+        String policy,
+        String columnName,
+        String principalAttribute) {
+
+    /**
+     * Maps a domain rule to its view.
+     *
+     * @param rule the rule
+     * @return the view
+     */
+    public static DataScopeView of(DataScopeRule rule) {
+        return new DataScopeView(
+                rule.id(),
+                rule.roleId(),
+                rule.datasourceId(),
+                rule.tableName(),
+                rule.policy() == null ? null : rule.policy().name(),
+                rule.columnName(),
+                rule.principalAttribute());
+    }
+}
