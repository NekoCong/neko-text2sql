+SELECT 'test-scope-counselor-course', 'test-role-counselor', 'campus', 'course', 'ALL', NULL, NULL, 1792454400000, 1792454400000
+WHERE NOT EXISTS (SELECT 1 FROM access_data_scope WHERE id = 'test-scope-counselor-course');
