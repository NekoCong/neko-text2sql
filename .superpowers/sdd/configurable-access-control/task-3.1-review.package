diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/R2dbcAccessControlRepository.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/R2dbcAccessControlRepository.java
index 83a6184..46606f0 100644
--- a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/R2dbcAccessControlRepository.java
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/R2dbcAccessControlRepository.java
@@ -146,20 +146,43 @@ public class R2dbcAccessControlRepository implements AccessControlRepository {
                 .bind("userId", userId)
                 .bind("createdAt", System.currentTimeMillis())
                 .bind("code", roleCode)
                 .fetch()
                 .rowsUpdated()
                 .flatMap(rows -> rows == null || rows == 0L
                         ? exists(userId, roleCode)
