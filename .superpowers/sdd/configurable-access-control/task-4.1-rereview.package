+            operands = flattenOr(parsed);
+        }
+        if (operands.size() != predicates.size()) {
+            throw new SqlPermissionException("无法生成行过滤条件，已拒绝执行");
+        }
+        for (int i = 0; i < predicates.size(); i++) {
+            if (!isInOverColumn(operands.get(i))) {
+                throw new SqlPermissionException("无法生成行过滤条件，已拒绝执行");
+            }
+        }
+    }
