+        String compacted = compact(sql);
+        assertThat(compacted).contains("student_no in ('2023001')");
+        assertThat(compacted).contains("student_id in (1)");
+        assertThat(compacted).doesNotContain("'2023002'").doesNotContain("student_id in (2)");
+    }
