         return client.sql("INSERT INTO access_role_datasource (role_id, datasource_id)"
                         + " SELECT r.id, :ds FROM access_role r"
                         + " WHERE r.code = :code AND r.enabled = TRUE"
                         + " AND NOT EXISTS (SELECT 1 FROM access_role_datasource d"
