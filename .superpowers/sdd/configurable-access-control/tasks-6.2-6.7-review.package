@@ -0,0 +1,13 @@
+package com.nekocong.text2sql.access.api.dto;
+
+/**
+ * One column of a datasource's live metadata, as returned to the data-scope editor.
+ *
+ * <p>Deliberately minimal: only the name and the introspected type name. The type name is what the
+ * data-scope editor needs to pair a column with a principal attribute; connection secrets and other
+ * datasource details are never returned.
+ *
+ * @param name the column name
+ * @param typeName the database-specific type name (e.g. {@code BIGINT}, {@code VARCHAR})
+ */
+public record DatasourceSchemaColumnView(String name, String typeName) {}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DatasourceSchemaTableView.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DatasourceSchemaTableView.java
new file mode 100644
index 0000000..38596d7
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DatasourceSchemaTableView.java
@@ -0,0 +1,17 @@
+package com.nekocong.text2sql.access.api.dto;
+
+import java.util.List;
+
+/**
+ * One table of a datasource's live metadata, as returned to the data-scope editor.
+ *
+ * @param name the table name
+ * @param columns the table's columns, in declaration order
+ */
+public record DatasourceSchemaTableView(String name, List<DatasourceSchemaColumnView> columns) {
+
+    /** Normalizes the column list so the view is structurally immutable. */
+    public DatasourceSchemaTableView {
+        columns = columns == null ? List.of() : List.copyOf(columns);
+    }
+}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DatasourceSchemaView.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DatasourceSchemaView.java
new file mode 100644
