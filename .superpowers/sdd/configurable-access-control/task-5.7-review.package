+package com.nekocong.text2sql.access;
+
+import com.nekocong.text2sql.security.Roles;
+import java.util.Collection;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Optional;
+import java.util.Set;
+import org.springframework.stereotype.Service;
+import reactor.core.publisher.Mono;
+
+/**
+ * The shared anti-escalation component: answers "may this actor grant these effective permissions?"
+ * for the permission matrix, the role parent edge and user role assignment.
+ *
+ * <p>The rule is the same everywhere: a <em>built-in administrator</em> may grant anything (the
+ * bootstrap exception); any other actor may only grant permission sets they themselves hold. The
+ * actor's own effective permissions are resolved with {@link AccessContextResolver} (which already
+ * applies the single-parent inheritance walk), and a role's effective permissions are computed with
+ * the resolver's {@code effectiveRoleIdsFor}/{@code effectivePermissionsForRoles} helpers — the walk
+ * is never reimplemented here.
+ *
+ * <p>Every lookup fails closed: an unresolvable actor (no roles, unknown id, a configuration cycle)
+ * resolves to an empty permission set, which denies anything they do not hold.
+ */
+@Service
+public class AccessEscalationService {
+
+    private final AccessContextResolver access;
+
+    private final AccessAdminRepository repository;
+
+    /**
+     * Creates the service.
+     *
+     * @param access the access-context resolver, reused for the effective-permission walk
+     * @param repository the admin repository, for role lookups
+     */
+    public AccessEscalationService(AccessContextResolver access, AccessAdminRepository repository) {
+        this.access = access;
+        this.repository = repository;
+    }
+
+    /**
+     * Resolves the actor's effective permission keys, failing closed to an empty set when the actor
+     * cannot be resolved (no roles, unknown, or a broken inheritance configuration).
+     *
+     * @param actorId the acting user id
+     * @return the effective permission keys
+     */
+    public Mono<Set<String>> actorPermissions(String actorId) {
+        return access.effectivePermissions(actorId).onErrorReturn(Set.of());
+    }
+
+    /**
+     * Reports whether the actor holds the built-in administrator role, directly or through
+     * inheritance. Fails closed to {@code false}.
+     *
+     * @param actorId the acting user id
+     * @return {@code true} when the built-in admin role is in the actor's effective role set
+     */
+    public Mono<Boolean> isBuiltInAdmin(String actorId) {
+        return Mono.zip(access.effectiveRoleIdsOf(actorId), repository.roles())
+                .map(
+                        tuple -> {
+                            Set<String> ids = new HashSet<>(tuple.getT1());
+                            for (AccessRole role : tuple.getT2()) {
+                                if (role.builtIn()
+                                        && Roles.ADMIN.equals(role.code())
+                                        && ids.contains(role.id())) {
+                                    return Boolean.TRUE;
+                                }
+                            }
+                            return Boolean.FALSE;
+                        })
+                .onErrorReturn(Boolean.FALSE);
+    }
+
+    /**
+     * Reports whether the actor covers every required permission. A built-in administrator covers
+     * anything; otherwise the required set must be a subset of the actor's effective permissions.
+     *
+     * @param actorId the acting user id
+     * @param required the effective permission set that would be granted
+     * @return {@code true} when the grant is allowed
+     */
+    public Mono<Boolean> actorCovers(String actorId, Set<String> required) {
+        if (required == null || required.isEmpty()) {
+            return Mono.just(Boolean.TRUE);
+        }
+        return isBuiltInAdmin(actorId)
+                .flatMap(
+                        admin ->
+                                admin
+                                        ? Mono.just(Boolean.TRUE)
+                                        : actorPermissions(actorId)
+                                                .map(permissions -> permissions.containsAll(required)));
+    }
+
+    /**
+     * Returns the first requested key the actor does not hold, or empty. A built-in administrator is
+     * never missing a key. Keys are inspected in sorted order so the reported key is stable.
+     *
+     * @param actorId the acting user id
+     * @param requestedKeys the requested permission keys
+     * @return the first missing key, or empty when the actor may grant every key
+     */
+    public Mono<Optional<String>> missingKey(String actorId, Set<String> requestedKeys) {
+        if (requestedKeys == null || requestedKeys.isEmpty()) {
+            return Mono.just(Optional.empty());
+        }
+        return isBuiltInAdmin(actorId)
+                .flatMap(
+                        admin -> {
+                            if (admin) {
+                                return Mono.just(Optional.<String>empty());
+                            }
+                            return actorPermissions(actorId)
+                                    .map(
+                                            permissions -> {
+                                                for (String key :
+                                                        requestedKeys.stream().sorted().toList()) {
+                                                    if (!permissions.contains(key)) {
+                                                        return Optional.of(key);
+                                                    }
+                                                }
+                                                return Optional.<String>empty();
+                                            });
+                        });
+    }
+
+    /**
+     * Computes one role's effective permission keys (its own grants plus its enabled ancestors'),
+     * reusing the resolver's inheritance walk.
+     *
+     * @param roleId the role id
+     * @return the effective permission keys
+     */
+    public Mono<Set<String>> effectivePermissionsOfRole(String roleId) {
+        return repository.role(roleId).flatMap(role -> effectivePermissionsOfRoles(List.of(role)));
+    }
+
+    /**
+     * Computes the effective permission keys of the given roles (each enabled role plus its enabled
+     * ancestors), reusing the resolver's inheritance walk.
+     *
+     * @param roles the directly assigned roles
+     * @return the union of effective permission keys
+     */
+    public Mono<Set<String>> effectivePermissionsOfRoles(Collection<AccessRole> roles) {
+        if (roles == null || roles.isEmpty()) {
+            return Mono.just(Set.of());
+        }
+        return access.effectiveRoleIdsFor(roles).flatMap(access::effectivePermissionsForRoles);
+    }
+}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/AccessLockoutService.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/AccessLockoutService.java
new file mode 100644
index 0000000..416e643
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/AccessLockoutService.java
@@ -0,0 +1,187 @@
+package com.nekocong.text2sql.access;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.function.Consumer;
+import org.springframework.stereotype.Service;
+import reactor.core.publisher.Mono;
+
+/**
+ * The shared last-administrator lockout check, evaluated in memory.
+ *
+ * <p>A mutation that could remove the last <em>enabled</em> user holding {@code access.manage} is
+ * rejected with {@code 409}. The check loads all roles, role-permission links and enabled users'
+ * role links, applies the proposed change in memory, then recomputes each enabled user's effective
+ * permission set with {@link AccessContextResolver#effectiveRoleIds} (the shared inheritance walk,
+ * never reimplemented). The change is unsafe only when a holder existed before and none remains
+ * after: an already locked-out system is not further blocked, so access can be re-established.
+ *
+ * <p>The evaluation is not strictly atomic with the mutation (the same residual TOCTOU as the 5.4
+ * user lockout); the mutation itself stays transactional. All lookups are bound SQL.
+ */
+@Service
+public class AccessLockoutService {
+
+    private final AccessAdminRepository repository;
+
+    /**
+     * Creates the service.
+     *
+     * @param repository the admin repository, for the read-only snapshot queries
+     */
+    public AccessLockoutService(AccessAdminRepository repository) {
+        this.repository = repository;
+    }
+
+    /**
+     * Reports whether replacing one role's permission set would still leave an enabled {@code
+     * access.manage} holder (or whether there was none to lose).
+     *
+     * @param roleId the role whose set is replaced
+     * @param newKeys the complete new key set
+     * @return {@code true} when the change may be applied
+     */
+    public Mono<Boolean> retainsAccessManageAfterPermissionReplace(String roleId, Set<String> newKeys) {
+        return evaluate(snapshot -> snapshot.replacePermissionKeys(roleId, newKeys));
+    }
+
+    /**
+     * Reports whether disabling one role would still leave an enabled {@code access.manage} holder.
+     *
+     * @param roleId the role to disable
+     * @return {@code true} when the change may be applied
+     */
+    public Mono<Boolean> retainsAccessManageAfterDisable(String roleId) {
+        return evaluate(snapshot -> snapshot.disableRole(roleId));
+    }
+
+    /**
+     * Reports whether reparenting one role would still leave an enabled {@code access.manage}
+     * holder.
+     *
+     * @param roleId the role being reparented
+     * @param newParentId the prospective parent id, or {@code null} to clear the parent
+     * @return {@code true} when the change may be applied
+     */
+    public Mono<Boolean> retainsAccessManageAfterReparent(String roleId, String newParentId) {
+        return evaluate(snapshot -> snapshot.reparentRole(roleId, newParentId));
+    }
+
+    /** Loads the snapshot, evaluates the before state, applies the change, and compares. */
+    private Mono<Boolean> evaluate(Consumer<Snapshot> mutation) {
+        return snapshot()
+                .map(
+                        snapshot -> {
+                            boolean before = snapshot.anyEnabledUserHoldsAccessManage();
+                            mutation.accept(snapshot);
+                            boolean after = snapshot.anyEnabledUserHoldsAccessManage();
+                            return !before || after;
+                        });
+    }
+
+    private Mono<Snapshot> snapshot() {
+        return Mono.zip(
+                        repository.roles(),
+                        repository.rolePermissionLinks(),
+                        repository.enabledUserRoles())
+                .map(tuple -> new Snapshot(tuple.getT1(), tuple.getT2(), tuple.getT3()));
+    }
+
+    /** The in-memory access-control graph, mutable so a proposed change can be applied. */
+    private static final class Snapshot {
+
+        private final Map<String, AccessRole> rolesById = new HashMap<>();
+
+        private final Map<String, Set<String>> keysByRoleId = new HashMap<>();
+
+        private final Map<String, Set<String>> rolesByUserId = new HashMap<>();
+
+        Snapshot(
+                List<AccessRole> roles,
+                List<RolePermissionLink> permissionLinks,
+                List<UserRoleLink> userRoles) {
+            for (AccessRole role : roles) {
+                rolesById.put(role.id(), role);
+            }
+            for (RolePermissionLink link : permissionLinks) {
+                keysByRoleId
+                        .computeIfAbsent(link.roleId(), key -> new HashSet<>())
+                        .add(link.permissionKey());
+            }
+            for (UserRoleLink link : userRoles) {
+                rolesByUserId
+                        .computeIfAbsent(link.userId(), key -> new HashSet<>())
+                        .add(link.roleId());
+            }
+        }
+
+        boolean anyEnabledUserHoldsAccessManage() {
+            for (Set<String> roleIds : rolesByUserId.values()) {
+                if (effectivePermissionKeys(roleIds).contains(Permissions.ACCESS_MANAGE)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private Set<String> effectivePermissionKeys(Set<String> directRoleIds) {
+            List<AccessRole> direct =
+                    directRoleIds.stream()
+                            .map(rolesById::get)
+                            .filter(Objects::nonNull)
+                            .toList();
+            List<String> effectiveIds =
+                    AccessContextResolver.effectiveRoleIds(
+                            direct, new ArrayList<>(rolesById.values()));
+            Set<String> keys = new HashSet<>();
+            for (String id : effectiveIds) {
+                Set<String> roleKeys = keysByRoleId.get(id);
+                if (roleKeys != null) {
+                    keys.addAll(roleKeys);
+                }
+            }
+            return keys;
+        }
+
+        void replacePermissionKeys(String roleId, Set<String> newKeys) {
+            keysByRoleId.put(roleId, newKeys == null ? Set.of() : new HashSet<>(newKeys));
+        }
+
+        void disableRole(String roleId) {
+            AccessRole role = rolesById.get(roleId);
+            if (role != null && role.enabled()) {
+                rolesById.put(
+                        roleId,
+                        new AccessRole(
+                                role.id(),
+                                role.code(),
+                                role.name(),
+                                role.description(),
+                                role.parentId(),
+                                role.builtIn(),
+                                false));
+            }
+        }
+
+        void reparentRole(String roleId, String newParentId) {
+            AccessRole role = rolesById.get(roleId);
+            if (role != null) {
+                rolesById.put(
+                        roleId,
+                        new AccessRole(
+                                role.id(),
+                                role.code(),
+                                role.name(),
+                                role.description(),
+                                newParentId,
+                                role.builtIn(),
+                                role.enabled()));
+            }
+        }
+    }
+}
