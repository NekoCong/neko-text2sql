new file mode 100644
index 0000000..54a73b8
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DatasourceMatrixRoleView.java
@@ -0,0 +1,27 @@
+package com.nekocong.text2sql.access.api.dto;
+
+import java.util.List;
+
+/**
+ * One role row in the datasource matrix.
+ *
+ * @param id the role id
+ * @param code the stable code
+ * @param name the display name
+ * @param builtIn whether the role is seeded and protected
+ * @param enabled whether the role participates in effective access
+ * @param datasourceIds the datasources granted to the role, sorted and free of duplicates
+ */
+public record DatasourceMatrixRoleView(
+        String id,
+        String code,
+        String name,
+        boolean builtIn,
+        boolean enabled,
+        List<String> datasourceIds) {
+
+    /** Normalizes the grant list so the view is structurally immutable. */
+    public DatasourceMatrixRoleView {
+        datasourceIds = datasourceIds == null ? List.of() : List.copyOf(datasourceIds);
+    }
+}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DatasourceMatrixView.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DatasourceMatrixView.java
new file mode 100644
index 0000000..8b634cb
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/DatasourceMatrixView.java
@@ -0,0 +1,20 @@
+package com.nekocong.text2sql.access.api.dto;
+
+import java.util.List;
+
+/**
+ * The role → datasource matrix shown on the admin page, keyed by role records (not role-code
+ * constants) so custom roles can be granted datasources.
+ *
+ * @param roles every role (built-in and custom), ordered by code, each with its datasource grants
+ * @param datasources every registered datasource, in registration order
+ */
+public record DatasourceMatrixView(
+        List<DatasourceMatrixRoleView> roles, List<DatasourceMatrixDatasourceView> datasources) {
+
+    /** Normalizes the collections so the view is structurally immutable. */
+    public DatasourceMatrixView {
+        roles = roles == null ? List.of() : List.copyOf(roles);
+        datasources = datasources == null ? List.of() : List.copyOf(datasources);
+    }
+}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/RoleDatasourcesRequest.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/RoleDatasourcesRequest.java
new file mode 100644
index 0000000..d9fc4f6
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/RoleDatasourcesRequest.java
@@ -0,0 +1,14 @@
+package com.nekocong.text2sql.access.api.dto;
+
+import java.util.List;
+
+/**
+ * Request body for replacing a role's datasource grant set.
+ *
+ * <p>The list is the <em>complete</em> new set, not a delta: an id absent from it is revoked. An
+ * empty list clears every grant of the role. Duplicates are de-duplicated and every id must exist in
+ * the datasource registry.
+ *
+ * @param datasourceIds the datasource ids the role should be able to query
+ */
+public record RoleDatasourcesRequest(List<String> datasourceIds) {}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/RoleDatasourcesView.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/RoleDatasourcesView.java
new file mode 100644
index 0000000..9bd144b
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/RoleDatasourcesView.java
@@ -0,0 +1,20 @@
+package com.nekocong.text2sql.access.api.dto;
+
+import java.util.List;
+
+/**
+ * One role's datasource grant set, as datasource ids.
+ *
+ * <p>Returned by both the read and the replace endpoints, so a client can apply the result without a
+ * second round trip. The list is ordered (by id) and free of duplicates.
+ *
+ * @param roleId the role id
+ * @param datasourceIds the datasource ids the role may query
+ */
+public record RoleDatasourcesView(String roleId, List<String> datasourceIds) {
+
+    /** Normalizes the id list so the view is structurally immutable. */
+    public RoleDatasourcesView {
+        datasourceIds = datasourceIds == null ? List.of() : List.copyOf(datasourceIds);
+    }
+}
