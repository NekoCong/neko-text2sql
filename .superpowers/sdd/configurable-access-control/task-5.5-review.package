+            insert =
+                    insert.then(
+                            client.sql("INSERT INTO access_role_datasource (role_id, datasource_id)"
+                                            + " VALUES (:roleId, :datasourceId)")
+                                    .bind("roleId", roleId)
+                                    .bind("datasourceId", datasourceId)
+                                    .then());
+        }
+        return delete.then(insert);
+    }
+
