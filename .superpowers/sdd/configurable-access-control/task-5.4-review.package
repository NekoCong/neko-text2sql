+                        .bind("id", id)
+                        .bind("username", username)
+                        .bind("passwordHash", passwordHash)
+                        .bind("createdAt", now);
+        spec = bindNullable(spec, "displayName", displayName);
+        return spec.then().then(assignRoles(id, roleIds)).then(user(id));
+    }
+
