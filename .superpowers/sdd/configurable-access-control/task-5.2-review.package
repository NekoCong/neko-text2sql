+    public Mono<AccessRolePermissionsView> permissionsOf(String roleId) {
+        return Mono.defer(
+                () -> {
+                    requireIdentifier(roleId);
+                    return repository
+                            .role(roleId)
+                            .switchIfEmpty(
+                                    Mono.error(
+                                            new ResponseStatusException(
