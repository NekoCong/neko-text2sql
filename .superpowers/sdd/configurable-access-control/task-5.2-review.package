@@ -0,0 +1,15 @@
+package com.nekocong.text2sql.access.api.dto;
+
+import java.util.List;
+
+/**
+ * Request body for replacing a role's permission set.
+ *
+ * <p>The list is the <em>complete</em> new set, not a delta: a key absent from it is revoked. An
+ * empty (or {@code null}) list clears every permission of the role. Duplicates are de-duplicated and
+ * every key must exist in the permission catalog.
+ *
+ * @param permissions the permission keys the role should hold
+ */
+public record AccessRolePermissionsRequest(List<String> permissions) {
+}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessRolePermissionsView.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessRolePermissionsView.java
new file mode 100644
index 0000000..f33fd59
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessRolePermissionsView.java
@@ -0,0 +1,20 @@
+package com.nekocong.text2sql.access.api.dto;
+
+import java.util.List;
+
+/**
+ * One role's permission set, as permission keys.
+ *
+ * <p>Returned by both the read and the replace endpoints, so a client can apply the result without
+ * a second round trip. The list is ordered (by key) and free of duplicates.
+ *
+ * @param roleId the role id
+ * @param permissions the permission keys the role holds
+ */
+public record AccessRolePermissionsView(String roleId, List<String> permissions) {
+
+    /** Normalizes the key list so the view is structurally immutable. */
+    public AccessRolePermissionsView {
+        permissions = permissions == null ? List.of() : List.copyOf(permissions);
+    }
+}
