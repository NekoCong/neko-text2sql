-// Session guard: rehydrate the auth store (so a page refresh keeps the session), send
-// guests to /login and keep signed-in users out of it. A route carrying `meta.permission`
-// refreshes the profile first, so a stale localStorage snapshot can never grant (or deny)
-// access against the server's current permission set.
+// Session guard: rehydrate the auth store, send guests to /login and keep signed-in users out of
+// it. Every gated route refreshes the effective profile before its permission is checked. Denied
+// destinations fall through to the first permitted page, or to a stable page when none is available.
 router.beforeEach(async (to) => {
   const auth = useAuthStore()
   await auth.restore()
+
   if (to.meta.public !== true && !auth.isAuthenticated) {
     return { name: 'login' }
   }
+
+  const firstAvailableDestination = () => {
+    const path = firstPermittedRoute((permission) => auth.can(permission))
+    // The path check is a final loop guard in case a route and the navigation map ever drift apart.
+    return path !== null && path !== to.path ? { path } : { name: 'no-permission' }
+  }
+
   if (to.meta.public === true && auth.isAuthenticated) {
-    return { name: 'chat' }
+    return firstAvailableDestination()
   }
-  if (to.meta.permission) {
+
+  // `admin` remains a backwards-compatible alias, but it is permission-based too: the display-only
+  // role claim is never consulted by this guard.
+  const requiredPermission =
+    to.meta.permission ?? (to.meta.admin === true ? 'access.manage' : undefined)
+  if (requiredPermission) {
     await auth.refreshProfile()
-    if (!auth.can(to.meta.permission)) {
-      return { name: 'chat' }
+    if (!auth.isAuthenticated) {
+      return { name: 'login' }
+    }
+    if (!auth.can(requiredPermission)) {
+      return firstAvailableDestination()
     }
-  }
-  if (to.meta.admin === true && auth.user?.role !== 'admin') {
-    return { name: 'chat' }
   }
   return true
 })
 
 router.afterEach((to) => {
   const title = to.meta.title
   document.title = title ? `${title} · Text2SQL` : 'Text2SQL'
 })
 
 export default router
diff --git a/text2sql-frontend/src/utils/navigation.ts b/text2sql-frontend/src/utils/navigation.ts
new file mode 100644
index 0000000..fc984ba
--- /dev/null
+++ b/text2sql-frontend/src/utils/navigation.ts
@@ -0,0 +1,63 @@
+/**
+ * Permission-gated application destinations, in landing-page priority order.
+ *
+ * This module deliberately has no Vue, Router or Pinia imports so the navigation mapping and
+ * fallback selection can be tested directly with the Node test runner.
+ */
+export type NavigationPlacement = 'menu' | 'dropdown'
+
+export interface AppNavigationEntry {
+  name: string
+  path: string
+  label: string
+  permission: string
+  placement: NavigationPlacement
+}
+
+export type PermissionChecker = (permission: string) => boolean
+
+/**
+ * Every user-facing destination exposed by the shell. The legacy datasource-access route is
+ * intentionally absent: it remains routable for old bookmarks but is no longer a navigation item.
+ */
+export const APP_NAVIGATION_ENTRIES: readonly AppNavigationEntry[] = [
+  { name: 'chat', path: '/', label: '对话', permission: 'chat.use', placement: 'menu' },
+  {
+    name: 'datasources',
+    path: '/datasources',
+    label: '数据源',
+    permission: 'datasource.read',
+    placement: 'menu',
+  },
+  {
+    name: 'model-settings',
+    path: '/settings/models',
+    label: '模型配置',
+    permission: 'model.manage',
+    placement: 'dropdown',
+  },
+  {
+    name: 'knowledge',
+    path: '/knowledge',
+    label: '知识库',
+    permission: 'access.manage',
+    placement: 'menu',
+  },
+  {
+    name: 'access-control',
+    path: '/admin/access-control',
+    label: '权限管理',
+    permission: 'access.manage',
+    placement: 'menu',
+  },
+]
+
+/** Returns the entries whose permission is granted by the supplied effective-permission check. */
+export function visibleNavigationEntries(can: PermissionChecker): AppNavigationEntry[] {
+  return APP_NAVIGATION_ENTRIES.filter((entry) => can(entry.permission))
+}
+
+/** Returns the highest-priority permitted path, or `null` when no app feature is available. */
+export function firstPermittedRoute(can: PermissionChecker): string | null {
+  return APP_NAVIGATION_ENTRIES.find((entry) => can(entry.permission))?.path ?? null
+}
