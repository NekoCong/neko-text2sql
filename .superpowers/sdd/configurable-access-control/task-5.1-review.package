@@ -0,0 +1,85 @@
+package com.nekocong.text2sql.access;
+
+import java.util.List;
+import reactor.core.publisher.Mono;
+
+/**
+ * Write access to the configurable access-control tables used by the admin API: role CRUD and the
+ * audit trail.
+ *
+ * <p>Kept separate from {@link AccessControlRepository}, which stays read-only for resolution.
+ */
+public interface AccessAdminRepository {
+
+    /**
+     * Lists every role, ordered by code.
+     *
+     * @return all roles
+     */
+    Mono<List<AccessRole>> roles();
+
+    /**
+     * Finds one role by id.
+     *
+     * @param id the role id
+     * @return the role, or empty
+     */
+    Mono<AccessRole> role(String id);
+
+    /**
+     * Finds one role by code.
+     *
+     * @param code the role code
+     * @return the role, or empty
+     */
+    Mono<AccessRole> roleByCode(String code);
+
+    /**
+     * Inserts a role with an app-generated id.
+     *
+     * @param code the code
+     * @param name the display name
+     * @param description the description, or {@code null}
+     * @param parentId the parent role, or {@code null}
+     * @param enabled whether the role participates in effective access
+     * @return the inserted role
+     */
+    Mono<AccessRole> insertRole(
+            String code, String name, String description, String parentId, boolean enabled);
+
+    /**
+     * Updates the mutable fields of a role ({@code code}, {@code built_in} and ids are untouched).
+     *
+     * @param id the role id
+     * @param name the display name
+     * @param description the description, or {@code null}
+     * @param parentId the parent role, or {@code null}
+     * @param enabled whether the role participates in effective access
+     * @return completion
+     */
+    Mono<Void> updateRole(
+            String id, String name, String description, String parentId, boolean enabled);
+
+    /**
+     * Appends one audit row.
+     *
+     * @param actorId the acting user id
+     * @param action the action key ({@code role.create}, {@code role.update}, {@code role.disable})
+     * @param entityType the entity type ({@code ROLE})
+     * @param entityId the affected role id, or {@code null}
+     * @param beforeJson the serialized before state, or {@code null}
+     * @param afterJson the serialized after state, or {@code null}
+     * @param result {@code SUCCESS} or {@code DENIED}
+     * @param reason the human-readable reason, or {@code null}
+     * @return completion
+     */
+    Mono<Void> record(
+            String actorId,
+            String action,
+            String entityType,
+            String entityId,
+            String beforeJson,
+            String afterJson,
+            String result,
+            String reason);
+}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/AccessAdminService.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/AccessAdminService.java
new file mode 100644
index 0000000..567acb8
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/AccessAdminService.java
@@ -0,0 +1,486 @@
+package com.nekocong.text2sql.access;
+
+import com.fasterxml.jackson.core.JsonProcessingException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.nekocong.text2sql.access.api.dto.AccessRoleRequest;
+import com.nekocong.text2sql.access.api.dto.AccessRoleView;
+import com.nekocong.text2sql.security.Roles;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Pattern;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Service;
+import org.springframework.web.server.ResponseStatusException;
+import reactor.core.publisher.Mono;
+
+/**
+ * Administrative role catalog: list, create and update (including enable/disable), with
+ * single-parent inheritance validated in the application.
+ *
+ * <p>Rules enforced here:
+ *
+ * <ul>
+ *   <li>{@code code} is required on create, matches {@value #CODE_PATTERN_DESCRIPTION}, and is
+ *       immutable and unique afterwards.
+ *   <li>{@code name} is required, at most {@value #MAX_NAME_LENGTH} characters.
+ *   <li>{@code parentId} must reference an existing role and must not create a cycle. A disabled
+ *       parent is allowed: it contributes nothing at resolution time.
+ *   <li>Built-in roles keep their {@code code}; the built-in administrator role cannot be disabled.
+ *       Other built-in roles may be renamed or disabled.
+ * </ul>
+ *
+ * <p>Every mutation appends exactly one {@code access_audit} row, and every rejected mutation appends
+ * a {@code DENIED} row carrying the reason. The application database has no transaction manager, so
+ * the mutation and its audit row are two statements: the audit row is issued after the mutation and
+ * a failed audit insert is logged rather than failing the request (the mutation may stand without
+ * its audit row; the reverse cannot occur).
+ */
+@Service
+public class AccessAdminService {
+
+    private static final Logger log = LoggerFactory.getLogger(AccessAdminService.class);
+
+    /** A role code: a lowercase letter, then lowercase letters/digits/underscore/dash (2-64 chars). */
+    static final String CODE_PATTERN_DESCRIPTION = "^[a-z][a-z0-9_-]{1,63}$";
+
+    private static final Pattern CODE_PATTERN = Pattern.compile(CODE_PATTERN_DESCRIPTION);
+
+    /** The alphabet role ids are generated from (UUIDs and the deterministic seed ids). */
+    private static final Pattern ID_PATTERN = Pattern.compile("^[A-Za-z0-9_-]{1,64}$");
+
+    private static final int MAX_NAME_LENGTH = 100;
+
+    private static final int MAX_REASON_LENGTH = 512;
+
+    private static final String ENTITY_TYPE = "ROLE";
+
+    private static final String ACTION_CREATE = "role.create";
+    private static final String ACTION_UPDATE = "role.update";
+    private static final String ACTION_DISABLE = "role.disable";
+
+    private static final String RESULT_SUCCESS = "SUCCESS";
+    private static final String RESULT_DENIED = "DENIED";
+
+    private static final String REASON_DUPLICATE_CODE = "角色编码已存在";
+    private static final String REASON_IMMUTABLE_CODE = "角色编码不可修改";
+    private static final String REASON_BUILT_IN_ADMIN = "内置管理员角色不能停用";
+    private static final String REASON_CYCLE = "会形成循环继承";
+    private static final String REASON_PARENT_MISSING = "父角色不存在";
+    private static final String REASON_ROLE_MISSING = "角色不存在";
+
+    private final AccessAdminRepository repository;
+    private final ObjectMapper objectMapper;
+
+    /**
+     * Creates the service.
+     *
+     * @param repository the admin repository
+     * @param objectMapper the shared Jackson mapper, used for the audit JSON payloads
+     */
+    public AccessAdminService(AccessAdminRepository repository, ObjectMapper objectMapper) {
+        this.repository = repository;
+        this.objectMapper = objectMapper;
+    }
+
+    /**
+     * Lists every role, ordered by code.
+     *
+     * @return the role views
+     */
+    public Mono<List<AccessRoleView>> list() {
+        return repository.roles().map(roles -> roles.stream().map(AccessRoleView::of).toList());
+    }
+
+    /**
+     * Creates a role.
+     *
+     * @param actorId the acting user id
+     * @param request the request (required)
+     * @return the created role
+     */
+    public Mono<AccessRoleView> create(String actorId, AccessRoleRequest request) {
+        return Mono.defer(
+                () -> {
+                    AccessRoleRequest body =
+                            request == null
+                                    ? new AccessRoleRequest(null, null, null, null, null)
+                                    : request;
+                    String code = validateCode(body.code());
+                    String name = validateName(body.name());
+                    String description = normalizeDescription(body.description());
+                    String parentId = blankToNull(body.parentId());
+                    boolean enabled = body.enabled() == null || body.enabled();
+                    return repository
+                            .roleByCode(code)
+                            .flatMap(
+                                    existing ->
+                                            deny(
+                                                    actorId,
+                                                    ACTION_CREATE,
+                                                    existing.id(),
+                                                    null,
+                                                    Map.of("code", code),
+                                                    REASON_DUPLICATE_CODE))
+                            .switchIfEmpty(
+                                    Mono.defer(
+                                            () ->
+                                                    requireParentExists(parentId)
+                                                            .then(
+                                                                    repository.insertRole(
+                                                                            code,
+                                                                            name,
+                                                                            description,
+                                                                            parentId,
+                                                                            enabled))
+                                                            .flatMap(
+                                                                    role ->
+                                                                            audit(
+                                                                                    actorId,
+                                                                                    ACTION_CREATE,
+                                                                                    role.id(),
+                                                                                    null,
+                                                                                    roleMap(role)))));
+                });
+    }
+
+    /**
+     * Updates a role's mutable fields: name, description, parent and enabled.
+     *
+     * <p>The code may be omitted or repeated verbatim but never changed. {@code null} name,
+     * description or enabled keeps the current value; {@code parentId} is taken literally, so
+     * {@code null} clears the parent. Turning an enabled role off is audited as
+     * {@code role.disable}.
+     *
+     * @param actorId the acting user id
+     * @param roleId the role id
+     * @param request the request (an empty body keeps every field unchanged)
+     * @return the updated role
+     */
+    public Mono<AccessRoleView> update(String actorId, String roleId, AccessRoleRequest request) {
+        return Mono.defer(
+                () -> {
+                    requireIdentifier(roleId);
+                    AccessRoleRequest body =
+                            request == null
+                                    ? new AccessRoleRequest(null, null, null, null, null)
+                                    : request;
+                    return repository
+                            .role(roleId)
+                            .switchIfEmpty(Mono.error(notFound(REASON_ROLE_MISSING)))
+                            .flatMap(before -> denyIfBad(actorId, before, body));
+                });
+    }
+
+    /**
+     * Applies an update request to a loaded role. The denial checks (immutable code, built-in admin)
+     * run first because they are audited; the validation and cycle check happen in
+     * {@link #applyUpdate}.
+     */
+    private Mono<AccessRoleView> denyIfBad(
+            String actorId, AccessRole before, AccessRoleRequest body) {
+        if (body.code() != null
+                && !body.code().isBlank()
+                && !before.code().equals(body.code().trim())) {
+            return deny(
+                    actorId,
+                    ACTION_UPDATE,
+                    before.id(),
+                    roleMap(before),
+                    Map.of("code", body.code()),
+                    REASON_IMMUTABLE_CODE);
+        }
+        boolean enabled = body.enabled() == null ? before.enabled() : body.enabled();
+        if (before.builtIn() && Roles.ADMIN.equals(before.code()) && !enabled) {
+            return deny(
+                    actorId,
+                    ACTION_DISABLE,
+                    before.id(),
+                    roleMap(before),
+                    Map.of("enabled", false),
+                    REASON_BUILT_IN_ADMIN);
+        }
+        return applyUpdate(actorId, before, body);
+    }
+
+    private Mono<AccessRoleView> applyUpdate(
+            String actorId, AccessRole before, AccessRoleRequest body) {
+        String name = body.name() == null ? before.name() : validateName(body.name());
+        String description =
+                body.description() == null
+                        ? before.description()
+                        : normalizeDescription(body.description());
+        String parentId = body.parentId() == null ? null : blankToNull(body.parentId());
+        boolean enabled = body.enabled() == null ? before.enabled() : body.enabled();
+        String action = actionFor(before, enabled);
+        // The state this request would produce; only used for the DENIED audit row.
+        Map<String, Object> requested = new HashMap<>(roleMap(before));
+        requested.put("name", name);
+        requested.put("description", description);
+        requested.put("parentId", parentId);
+        requested.put("enabled", enabled);
+        return validateParent(before, parentId)
+                .onErrorResume(
+                        CycleDenied.class,
+                        denial ->
+                                deny(
+                                                actorId,
+                                                action,
+                                                before.id(),
+                                                roleMap(before),
+                                                requested,
+                                                denial.getMessage())
+                                        .then())
+                .then(
+                        Mono.defer(
+                                () ->
+                                        repository.updateRole(
+                                                before.id(), name, description, parentId, enabled)))
+                .then(repository.role(before.id()))
+                .flatMap(
+                        after -> audit(actorId, action, after.id(), roleMap(before), roleMap(after)));
+    }
+
+    // --- validation -------------------------------------------------------------------------
+
+    private static String validateCode(String code) {
+        String value = code == null ? null : code.trim();
+        if (value == null || value.isEmpty()) {
+            throw badRequest("角色编码不能为空");
+        }
+        if (!CODE_PATTERN.matcher(value).matches()) {
+            throw badRequest("角色编码只能包含小写字母、数字、下划线和短横线，并且以字母开头（2-64 位）");
+        }
+        return value;
+    }
+
+    private static String validateName(String name) {
+        String value = name == null ? null : name.trim();
+        if (value == null || value.isEmpty()) {
+            throw badRequest("角色名称不能为空");
+        }
+        if (value.length() > MAX_NAME_LENGTH) {
+            throw badRequest("角色名称不能超过 " + MAX_NAME_LENGTH + " 个字符");
+        }
+        return value;
+    }
+
+    private static String normalizeDescription(String description) {
+        if (description == null) {
+            return null;
+        }
+        String value = description.trim();
+        return value.isEmpty() ? null : value;
+    }
+
+    /**
+     * Rejects a path id outside the identifier alphabet ids are generated from (letters, digits,
+     * {@code -} and {@code _}). Ids are never interpolated into SQL; this only rejects obviously
+     * malformed input early.
+     */
+    private static void requireIdentifier(String roleId) {
+        if (roleId == null || roleId.isBlank() || !ID_PATTERN.matcher(roleId).matches()) {
+            throw badRequest("角色标识无效");
+        }
+    }
+
+    /** On create, a parent only has to exist; a new role cannot close a cycle. */
+    private Mono<Void> requireParentExists(String parentId) {
+        if (parentId == null) {
+            return Mono.empty();
+        }
+        return repository
+                .role(parentId)
+                .switchIfEmpty(Mono.error(notFound(REASON_PARENT_MISSING)))
+                .then();
+    }
+
+    /**
+     * On update, the parent must exist and linking the role under it must keep the single-parent
+     * graph acyclic.
+     *
+     * <p>Walks up from the prospective parent, one lookup at a time, following the stored parent
+     * chain. Reaching the role itself means the new link would close a cycle: its own id, any
+     * descendant, or an ancestor that already leads back. A disabled parent is fine (it contributes
+     * nothing at resolution time); a dangling or looping existing chain is refused rather than
+     * extended, so the stored configuration stays acyclic.
+     */
+    private Mono<Void> validateParent(AccessRole role, String parentId) {
+        if (parentId == null) {
+            return Mono.empty();
+        }
+        if (parentId.equals(role.id())) {
+            return Mono.error(new CycleDenied());
+        }
+        return climbToRoot(role.id(), role, parentId, parentId, new HashSet<>());
+    }
+
+    /**
+     * Walks the parent chain starting at {@code current}, failing on the role or on a visited node.
+     *
+     * @param roleId the role being moved
+     * @param role the role's current state (its old parent edge is replaced, so it is not followed)
+     * @param start the prospective parent id, used in the not-found message
+     * @param current the node whose parent to follow
+     * @param visited the ids already visited on this walk
+     */
+    private Mono<Void> climbToRoot(
+            String roleId, AccessRole role, String start, String current, Set<String> visited) {
+        if (current == null) {
+            return Mono.empty();
+        }
+        if (current.equals(roleId)) {
+            return Mono.error(new CycleDenied());
+        }
+        if (!visited.add(current)) {
+            return Mono.error(new CycleDenied());
+        }
+        if (current.equals(start)) {
+            // The prospective parent must exist even though its chain was not entered yet.
+            return repository
+                    .role(current)
+                    .switchIfEmpty(Mono.error(notFound(REASON_PARENT_MISSING)))
+                    .flatMap(found -> climbToRoot(roleId, role, start, found.parentId(), visited));
+        }
+        if (current.equals(role.parentId())) {
+            // The role is moving here: its previous parent edge is deleted by this update.
+            return Mono.empty();
+        }
+        return repository
+                .role(current)
+                .switchIfEmpty(Mono.error(notFound(REASON_PARENT_MISSING)))
+                .flatMap(found -> climbToRoot(roleId, role, start, found.parentId(), visited));
+    }
+
+    /** A rejected parent link that would close an inheritance cycle (audited as DENIED). */
+    private static final class CycleDenied extends RuntimeException {
+
+        private CycleDenied() {
+            super(REASON_CYCLE, null, false, false);
+        }
+    }
+
+    // --- audit ------------------------------------------------------------------------------
+
+    /** Appends the SUCCESS row for a completed mutation and returns the resulting state. */
+    private Mono<AccessRoleView> audit(
+            String actorId,
+            String action,
+            String entityId,
+            Map<String, Object> before,
+            Map<String, Object> after) {
+        return repository
+                .record(
+                        actorId,
+                        action,
+                        ENTITY_TYPE,
+                        entityId,
+                        json(before),
+                        json(after),
+                        RESULT_SUCCESS,
+                        null)
+                .onErrorResume(error -> auditFailure(action, entityId, error))
+                .thenReturn(new AccessRoleView(
+                        String.valueOf(after.get("id")),
+                        String.valueOf(after.get("code")),
+                        String.valueOf(after.get("name")),
+                        (String) after.get("description"),
+                        (String) after.get("parentId"),
+                        Boolean.TRUE.equals(after.get("builtIn")),
+                        Boolean.TRUE.equals(after.get("enabled"))));
+    }
+
+    /** Appends a DENIED row for a rejected mutation, then fails with the matching HTTP status. */
+    private Mono<AccessRoleView> deny(
+            String actorId,
+            String action,
+            String entityId,
+            Map<String, Object> before,
+            Map<String, Object> requested,
+            String reason) {
+        return repository
+                .record(
+                        actorId,
+                        action,
+                        ENTITY_TYPE,
+                        entityId,
+                        json(before),
+                        json(requested),
+                        RESULT_DENIED,
+                        truncate(reason))
+                .onErrorResume(error -> auditFailure(action, entityId, error))
+                .then(Mono.error(conflict(reason)));
+    }
+
+    private static Mono<Void> auditFailure(String action, String entityId, Throwable error) {
+        log.error(
+                "Failed to append the access audit row {} for role {}; the mutation is not rolled"
+                        + " back",
+                action,
+                entityId,
+                error);
+        return Mono.empty();
+    }
+
+    private static String actionFor(AccessRole before, boolean enabled) {
+        return before.enabled() && !enabled ? ACTION_DISABLE : ACTION_UPDATE;
+    }
+
+    private String json(Map<String, Object> value) {
+        if (value == null) {
+            return null;
+        }
+        try {
+            return objectMapper.writeValueAsString(value);
+        } catch (JsonProcessingException ex) {
+            log.warn("Failed to serialize the access-audit payload", ex);
+            return null;
+        }
+    }
+
+    /**
+     * The audited projection of a role: exactly the fields {@link AccessRoleView} exposes, and
+     * nothing else (never secrets).
+     */
+    private static Map<String, Object> roleMap(AccessRole role) {
+        Map<String, Object> map = new HashMap<>();
+        map.put("id", role.id());
+        map.put("code", role.code());
+        map.put("name", role.name());
+        map.put("description", role.description());
+        map.put("parentId", role.parentId());
+        map.put("builtIn", role.builtIn());
+        map.put("enabled", role.enabled());
+        return map;
+    }
+
+    private static String truncate(String reason) {
+        return reason == null || reason.length() <= MAX_REASON_LENGTH
+                ? reason
+                : reason.substring(0, MAX_REASON_LENGTH);
+    }
+
+    private static String blankToNull(String value) {
+        if (value == null) {
+            return null;
+        }
+        String trimmed = value.trim();
+        return trimmed.isEmpty() ? null : trimmed;
+    }
+
+    private static ResponseStatusException badRequest(String message) {
+        return new ResponseStatusException(HttpStatus.BAD_REQUEST, message);
+    }
+
+    private static ResponseStatusException notFound(String message) {
+        return new ResponseStatusException(HttpStatus.NOT_FOUND, message);
+    }
+
+    private static ResponseStatusException conflict(String message) {
+        return new ResponseStatusException(HttpStatus.CONFLICT, message);
+    }
+}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/R2dbcAccessAdminRepository.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/R2dbcAccessAdminRepository.java
new file mode 100644
index 0000000..e44a339
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/R2dbcAccessAdminRepository.java
@@ -0,0 +1,141 @@
+package com.nekocong.text2sql.access;
+
+import java.util.List;
+import java.util.UUID;
+import org.springframework.r2dbc.core.DatabaseClient;
+import org.springframework.stereotype.Repository;
+import reactor.core.publisher.Mono;
+
+/**
+ * R2DBC implementation of {@link AccessAdminRepository}.
+ *
+ * <p>Every value is bound as a placeholder; only static column lists are concatenated into the SQL.
+ * Ids are app-generated UUIDs because R2DBC has no portable generated-key API.
+ */
+@Repository
+public class R2dbcAccessAdminRepository implements AccessAdminRepository {
+
+    private static final String ROLE_COLUMNS =
+            "id, code, name, description, parent_id, built_in, enabled";
+
+    private final DatabaseClient client;
+
+    /**
+     * Creates the repository.
+     *
+     * @param client the R2DBC database client
+     */
+    public R2dbcAccessAdminRepository(DatabaseClient client) {
+        this.client = client;
+    }
+
+    @Override
+    public Mono<List<AccessRole>> roles() {
+        return client.sql("SELECT " + ROLE_COLUMNS + " FROM access_role ORDER BY code")
+                .map((row, meta) -> role(row))
+                .all()
+                .collectList();
+    }
+
+    @Override
+    public Mono<AccessRole> role(String id) {
+        return client.sql("SELECT " + ROLE_COLUMNS + " FROM access_role WHERE id = :id")
+                .bind("id", id)
+                .map((row, meta) -> role(row))
+                .one();
+    }
+
+    @Override
+    public Mono<AccessRole> roleByCode(String code) {
+        return client.sql("SELECT " + ROLE_COLUMNS + " FROM access_role WHERE code = :code")
+                .bind("code", code)
+                .map((row, meta) -> role(row))
+                .one();
+    }
+
+    @Override
+    public Mono<AccessRole> insertRole(
+            String code, String name, String description, String parentId, boolean enabled) {
+        String id = UUID.randomUUID().toString();
+        long now = System.currentTimeMillis();
+        DatabaseClient.GenericExecuteSpec spec =
+                client.sql("INSERT INTO access_role"
+                                + " (id, code, name, description, parent_id, built_in, enabled,"
+                                + " created_at, updated_at)"
+                                + " VALUES (:id, :code, :name, :description, :parentId, FALSE, :enabled,"
+                                + " :createdAt, :updatedAt)")
+                        .bind("id", id)
+                        .bind("id", id)
+                        .bind("code", code)
+                        .bind("name", name)
+                        .bind("enabled", enabled)
+                        .bind("createdAt", now)
+                        .bind("updatedAt", now);
+        spec = bindNullable(spec, "description", description);
+        spec = bindNullable(spec, "parentId", parentId);
+        return spec.then()
+                .thenReturn(new AccessRole(id, code, name, description, parentId, false, enabled));
+    }
+
+    @Override
+    public Mono<Void> updateRole(
+            String id, String name, String description, String parentId, boolean enabled) {
+        DatabaseClient.GenericExecuteSpec spec =
+                client.sql("UPDATE access_role"
+                                + " SET name = :name, description = :description,"
+                                + " parent_id = :parentId, enabled = :enabled, updated_at = :updatedAt"
+                                + " WHERE id = :id")
+                        .bind("id", id)
+                        .bind("name", name)
+                        .bind("enabled", enabled)
+                        .bind("updatedAt", System.currentTimeMillis());
+        spec = bindNullable(spec, "description", description);
+        spec = bindNullable(spec, "parentId", parentId);
+        return spec.then();
+    }
+
+    @Override
+    public Mono<Void> record(
+            String actorId,
+            String action,
+            String entityType,
+            String entityId,
+            String beforeJson,
+            String afterJson,
+            String result,
+            String reason) {
+        DatabaseClient.GenericExecuteSpec spec =
+                client.sql("INSERT INTO access_audit"
+                                + " (id, actor_id, action, entity_type, entity_id, before_json,"
+                                + " after_json, result, reason, created_at)"
+                                + " VALUES (:id, :actorId, :action, :entityType, :entityId,"
+                                + " :beforeJson, :afterJson, :result, :reason, :createdAt)")
+                        .bind("id", UUID.randomUUID().toString())
+                        .bind("actorId", actorId)
+                        .bind("action", action)
+                        .bind("entityType", entityType)
+                        .bind("result", result)
+                        .bind("createdAt", System.currentTimeMillis());
+        spec = bindNullable(spec, "entityId", entityId);
+        spec = bindNullable(spec, "beforeJson", beforeJson);
+        spec = bindNullable(spec, "afterJson", afterJson);
+        spec = bindNullable(spec, "reason", reason);
+        return spec.then();
+    }
+
+    private static DatabaseClient.GenericExecuteSpec bindNullable(
+            DatabaseClient.GenericExecuteSpec spec, String name, String value) {
+        return value == null ? spec.bindNull(name, String.class) : spec.bind(name, value);
+    }
+
+    private static AccessRole role(io.r2dbc.spi.Row row) {
+        return new AccessRole(
+                row.get("id", String.class),
+                row.get("code", String.class),
+                row.get("name", String.class),
+                row.get("description", String.class),
+                row.get("parent_id", String.class),
+                Boolean.TRUE.equals(row.get("built_in", Boolean.class)),
+                Boolean.TRUE.equals(row.get("enabled", Boolean.class)));
+    }
+}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/AccessControlController.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/AccessControlController.java
new file mode 100644
index 0000000..0961eca
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/AccessControlController.java
@@ -0,0 +1,101 @@
+package com.nekocong.text2sql.access.api;
+
+import com.nekocong.text2sql.access.AccessAdminService;
+import com.nekocong.text2sql.access.api.dto.AccessRoleRequest;
+import com.nekocong.text2sql.access.api.dto.AccessRoleView;
+import java.util.List;
+import java.util.Objects;
+import org.springframework.http.HttpStatus;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.context.ReactiveSecurityContextHolder;
+import org.springframework.security.oauth2.jwt.Jwt;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.server.ResponseStatusException;
+import reactor.core.publisher.Mono;
+
+/**
+ * Admin API for the role catalog: list, create and update roles.
+ *
+ * <p>There is no delete: a role is disabled with {@code PUT {enabled:false}}. Access is enforced by
+ * {@code SecurityConfig} ({@code /api/admin/**} requires the {@code access.manage} permission
+ * resolved from the access-control tables), so an unauthorized caller never reaches these handlers.
+ *
+ * <p>The acting user id (the token subject) is passed to the service for the audit trail; without an
+ * authenticated principal the request fails closed with {@code 401}.
+ */
+@RestController
+@RequestMapping("/api/admin/access-control/roles")
+public class AccessControlController {
+
+    private final AccessAdminService service;
+
+    /**
+     * Creates the controller.
+     *
+     * @param service the role administration service
+     */
+    public AccessControlController(AccessAdminService service) {
+        this.service = service;
+    }
+
+    /**
+     * Lists every role, ordered by code.
+     *
+     * @return the roles
+     */
+    @GetMapping
+    public Mono<List<AccessRoleView>> list() {
+        return service.list();
+    }
+
+    /**
+     * Creates a role.
+     *
+     * @param request the role
+     * @return the created role
+     */
+    @PostMapping
+    @ResponseStatus(HttpStatus.CREATED)
+    public Mono<AccessRoleView> create(@RequestBody AccessRoleRequest request) {
+        return actorId().flatMap(actor -> service.create(actor, request));
+    }
+
+    /**
+     * Updates a role ({@code code} is immutable).
+     *
+     * @param id the role id
+     * @param request the new values; {@code null} fields keep their current value
+     * @return the updated role
+     */
+    @PutMapping("/{id}")
+    public Mono<AccessRoleView> update(
+            @PathVariable String id, @RequestBody(required = false) AccessRoleRequest request) {
+        return actorId().flatMap(actor -> service.update(actor, id, request));
+    }
+
+    /**
+     * Reads the acting user id from the authenticated JWT principal.
+     *
+     * @return the user id, or an error when the principal is missing (fail closed)
+     */
+    private static Mono<String> actorId() {
+        return ReactiveSecurityContextHolder.getContext()
+                .map(context -> context.getAuthentication())
+                .filter(Objects::nonNull)
+                .map(Authentication::getPrincipal)
+                .filter(Jwt.class::isInstance)
+                .map(Jwt.class::cast)
+                .map(Jwt::getSubject)
+                .filter(subject -> subject != null && !subject.isBlank())
+                // The decoder has already verified the signature, expiry and issuer.
+                .switchIfEmpty(
+                        Mono.error(new ResponseStatusException(HttpStatus.UNAUTHORIZED, "未认证")));
+    }
+}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessRoleRequest.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessRoleRequest.java
new file mode 100644
index 0000000..17e3302
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessRoleRequest.java
@@ -0,0 +1,18 @@
+package com.nekocong.text2sql.access.api.dto;
+
+/**
+ * Request body for creating or updating a role.
+ *
+ * <p>On create, {@code code} is required. On update it may be omitted (or sent identical) but never
+ * changed: the code is immutable once assigned. Fields left {@code null} on update keep their
+ * current value, except {@code parentId}: {@code null} clears the parent.
+ *
+ * @param code the stable role code (required on create; immutable)
+ * @param name the display name
+ * @param description the description
+ * @param parentId the parent role id (optional)
+ * @param enabled whether the role participates in effective access (defaults to {@code true} on
+ *     create)
+ */
+public record AccessRoleRequest(
+        String code, String name, String description, String parentId, Boolean enabled) {}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessRoleView.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessRoleView.java
new file mode 100644
index 0000000..305e1a7
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessRoleView.java
@@ -0,0 +1,41 @@
+package com.nekocong.text2sql.access.api.dto;
+
+import com.nekocong.text2sql.access.AccessRole;
+
+/**
+ * A role as returned to clients.
+ *
+ * @param id the role id
+ * @param code the stable code
+ * @param name the display name
+ * @param description the description, or {@code null}
+ * @param parentId the parent role, or {@code null}
+ * @param builtIn whether the role is seeded and protected
+ * @param enabled whether the role participates in effective access
+ */
+public record AccessRoleView(
+        String id,
+        String code,
+        String name,
+        String description,
+        String parentId,
+        boolean builtIn,
+        boolean enabled) {
+
+    /**
+     * Maps a domain role to its view.
+     *
+     * @param role the role
+     * @return the view
+     */
+    public static AccessRoleView of(AccessRole role) {
+        return new AccessRoleView(
+                role.id(),
+                role.code(),
+                role.name(),
+                role.description(),
+                role.parentId(),
+                role.builtIn(),
+                role.enabled());
+    }
+}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/controller/ApiExceptionHandler.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/controller/ApiExceptionHandler.java
index 80f132e..6d7e852 100644
--- a/text2sql-backend/src/main/java/com/nekocong/text2sql/controller/ApiExceptionHandler.java
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/controller/ApiExceptionHandler.java
@@ -1,30 +1,55 @@
 package com.nekocong.text2sql.controller;
 
 import com.nekocong.text2sql.security.SqlPermissionException;
 import java.util.Map;
 import org.springframework.http.HttpStatus;
 import org.springframework.http.ResponseEntity;
 import org.springframework.web.bind.annotation.ExceptionHandler;
 import org.springframework.web.bind.annotation.RestControllerAdvice;
+import org.springframework.web.server.ResponseStatusException;
 
 /**
  * Maps permission failures raised outside the SSE path onto HTTP 403 with a readable reason.
  *
  * <p>The SSE endpoints already turn errors into an {@code error} event, so this advice mainly covers
- * the synchronous endpoints (and keeps a permission problem from surfacing as a bare 500).
+ * the synchronous endpoints (and keeps a permission problem from surfacing as a bare 500). It also
+ * renders a deliberate {@link ResponseStatusException} raised by a controller or service as
+ * {@code {"status": ..., "message": ...}}, the same shape Spring's default handler uses.
+ *
+ * <p>Status exceptions raised in a filter (before handler mapping) never reach this advice: Spring no
+ * longer routes them through the handler-exception resolvers, so the access-status filter's own JSON
+ * body is preserved.
  */
 @RestControllerAdvice
 public class ApiExceptionHandler {
 
     /**
      * Handles a rejected statement or datasource.
      *
      * @param exception the failure
      * @return a 403 response carrying the reason
      */
     @ExceptionHandler(SqlPermissionException.class)
     public ResponseEntity<Map<String, String>> handlePermission(SqlPermissionException exception) {
         return ResponseEntity.status(HttpStatus.FORBIDDEN)
                 .body(Map.of("error", "Forbidden", "message", exception.getMessage()));
     }
+
+    /**
+     * Renders a deliberate status exception raised by a controller or service.
+     *
+     * @param exception the failure
+     * @return the mapped response
+     */
+    @ExceptionHandler(ResponseStatusException.class)
+    public ResponseEntity<Map<String, Object>> handleStatus(ResponseStatusException exception) {
+        HttpStatus resolved = HttpStatus.resolve(exception.getStatusCode().value());
+        if (resolved == null) {
+            resolved = HttpStatus.INTERNAL_SERVER_ERROR;
+        }
+        String reason = exception.getReason();
+        String message = reason == null || reason.isBlank() ? resolved.getReasonPhrase() : reason;
+        return ResponseEntity.status(resolved)
+                .body(Map.of("status", resolved.value(), "message", message));
+    }
 }
diff --git a/text2sql-backend/src/test/java/com/nekocong/text2sql/web/AccessControlRoleTest.java b/text2sql-backend/src/test/java/com/nekocong/text2sql/web/AccessControlRoleTest.java
new file mode 100644
index 0000000..56634d4
--- /dev/null
+++ b/text2sql-backend/src/test/java/com/nekocong/text2sql/web/AccessControlRoleTest.java
@@ -0,0 +1,445 @@
+package com.nekocong.text2sql.web;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.nekocong.text2sql.access.AccessControlRepository;
+import com.nekocong.text2sql.repository.UserRepository;
+import com.nekocong.text2sql.security.Roles;
+import com.nekocong.text2sql.user.AppUser;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.web.server.LocalServerPort;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.MediaType;
+import org.springframework.r2dbc.core.DatabaseClient;
+import org.springframework.security.crypto.password.PasswordEncoder;
+import org.springframework.test.web.reactive.server.WebTestClient;
+
+/**
+ * The role catalog admin API: create/update/enable/disable with inheritance validation, built-in
+ * protection and one audit row per mutation.
+ */
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+class AccessControlRoleTest {
+
+    private static final String PASSWORD = "secret123";
+
+    private static final String ROLES = "/api/admin/access-control/roles";
+
+    @LocalServerPort
+    private int port;
+
+    @Autowired
+    private UserRepository users;
+
+    @Autowired
+    private PasswordEncoder passwordEncoder;
+
+    @Autowired
+    private AccessControlRepository access;
+
+    @Autowired
+    private DatabaseClient db;
+
+    private WebTestClient client;
+    private String adminToken;
+    private String adminId;
+
+    @BeforeEach
+    void setUp() {
+        client = WebTestClient.bindToServer().baseUrl("http://localhost:" + port).build();
+        String username = unique("admin");
+        AppUser admin = users.insert(username, passwordEncoder.encode(PASSWORD), "Admin", Roles.ADMIN).block();
+        access.assignRoleByCode(admin.id(), Roles.ADMIN).block();
+        adminId = admin.id();
+        adminToken = TestAuth.login(client, username, PASSWORD);
+    }
+
+    @Test
+    void createsARoleThatAppearsInTheList() {
+        String code = unique("teacher");
+
+        client.post()
+                .uri(ROLES)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(
+                        Map.of(
+                                "code",
+                                code,
+                                "name",
+                                "教师",
+                                "description",
+                                "授课教师",
+                                "enabled",
+                                true))
+                .exchange()
+                .expectStatus()
+                .isCreated()
+                .expectBody()
+                .jsonPath("$.id")
+                .isNotEmpty()
+                .jsonPath("$.code")
+                .isEqualTo(code)
+                .jsonPath("$.name")
+                .isEqualTo("教师")
+                .jsonPath("$.builtIn")
+                .isEqualTo(false)
+                .jsonPath("$.enabled")
+                .isEqualTo(true)
+                .jsonPath("$.parentId")
+                .doesNotExist();
+
+        String id = roleIdByCode(code);
+
+        client.get()
+                .uri(ROLES)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .exchange()
+                .expectStatus()
+                .isOk()
+                .expectBody()
+                .jsonPath("$[*].id")
+                .value(ids -> assertThat((List<Object>) ids).contains(id))
+                .jsonPath("$[0].id")
+                .exists();
+
+        assertThat(auditRows(adminId, "role.create", id, "SUCCESS")).isEqualTo(1);
+    }
+
+    @Test
+    void rejectsADuplicateCode() {
+        String code = createRole("讲师", null);
+
+        client.post()
+                .uri(ROLES)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("code", code, "name", "重复"))
+                .exchange()
+                .expectStatus()
+                .isEqualTo(409)
+                .expectBody()
+                .jsonPath("$.message")
+                .isEqualTo("角色编码已存在");
+
+        assertThat(auditRows(adminId, "role.create", null, "DENIED"))
+                .as("one DENIED row for the rejected create")
+                .isEqualTo(1);
+    }
+
+    @Test
+    void updatesNameDescriptionAndParent() {
+        String parentCode = createRole("父角色", null);
+        String parentId = roleIdByCode(parentCode);
+        String childCode = createRole("子角色", null);
+        String childId = roleIdByCode(childCode);
+
+        client.put()
+                .uri(ROLES + "/" + childId)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(
+                        Map.of(
+                                "name",
+                                "子角色（改）",
+                                "description",
+                                "继承自父角色",
+                                "parentId",
+                                parentId))
+                .exchange()
+                .expectStatus()
+                .isOk()
+                .expectBody()
+                .jsonPath("$.id")
+                .isEqualTo(childId)
+                .jsonPath("$.name")
+                .isEqualTo("子角色（改）")
+                .jsonPath("$.description")
+                .isEqualTo("继承自父角色")
+                .jsonPath("$.parentId")
+                .isEqualTo(parentId);
+
+        assertThat(auditRows(adminId, "role.update", childId, "SUCCESS")).isEqualTo(1);
+    }
+
+    @Test
+    void rejectsACodeChange() {
+        String code = createRole("不可改编码", null);
+        String id = roleIdByCode(code);
+
+        client.put()
+                .uri(ROLES + "/" + id)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("code", unique("changed"), "name", "改名"))
+                .exchange()
+                .expectStatus()
+                .isEqualTo(409)
+                .expectBody()
+                .jsonPath("$.message")
+                .isEqualTo("角色编码不可修改");
+
+        assertThat(auditRows(adminId, "role.update", id, "DENIED"))
+                .as("exactly one DENIED row for the rejected code change")
+                .isEqualTo(1);
+        assertThat(roleIdByCode(code)).isEqualTo(id);
+    }
+
+    @Test
+    void rejectsSelfParentAndTwoRoleCycle() {
+        String firstCode = createRole("环一", null);
+        String firstId = roleIdByCode(firstCode);
+        String secondCode = createRole("环二", null);
+        String secondId = roleIdByCode(secondCode);
+
+        client.put()
+                .uri(ROLES + "/" + firstId)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("parentId", firstId))
+                .exchange()
+                .expectStatus()
+                .isEqualTo(409)
+                .expectBody()
+                .jsonPath("$.message")
+                .isEqualTo("会形成循环继承");
+
+        client.put()
+                .uri(ROLES + "/" + firstId)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("parentId", secondId))
+                .exchange()
+                .expectStatus()
+                .isOk();
+
+        client.put()
+                .uri(ROLES + "/" + secondId)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("parentId", firstId))
+                .exchange()
+                .expectStatus()
+                .isEqualTo(409)
+                .expectBody()
+                .jsonPath("$.message")
+                .isEqualTo("会形成循环继承");
+
+        assertThat(auditRows(adminId, "role.update", secondId, "DENIED")).isEqualTo(1);
+    }
+
+    @Test
+    void rejectsAnUnknownParent() {
+        String code = createRole("孤儿", null);
+        String id = roleIdByCode(code);
+
+        client.put()
+                .uri(ROLES + "/" + id)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("parentId", UUID.randomUUID().toString()))
+                .exchange()
+                .expectStatus()
+                .isNotFound()
+                .expectBody()
+                .jsonPath("$.message")
+                .isEqualTo("父角色不存在");
+    }
+
+    @Test
+    void rejectsAnUnknownRoleId() {
+        client.put()
+                .uri(ROLES + "/" + UUID.randomUUID())
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("name", "不存在"))
+                .exchange()
+                .expectStatus()
+                .isNotFound();
+    }
+
+    @Test
+    void validatesTheCodeAndName() {
+        client.post()
+                .uri(ROLES)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("code", "Bad Code!", "name", "非法"))
+                .exchange()
+                .expectStatus()
+                .isBadRequest();
+
+        client.post()
+                .uri(ROLES)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("code", unique("noname")))
+                .exchange()
+                .expectStatus()
+                .isBadRequest();
+    }
+
+    @Test
+    void disablesACustomRoleButNotTheBuiltInAdmin() {
+        String code = createRole("可停用", null);
+        String id = roleIdByCode(code);
+
+        client.put()
+                .uri(ROLES + "/" + id)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("enabled", false))
+                .exchange()
+                .expectStatus()
+                .isOk()
+                .expectBody()
+                .jsonPath("$.enabled")
+                .isEqualTo(false);
+
+        assertThat(auditRows(adminId, "role.disable", id, "SUCCESS")).isEqualTo(1);
+
+        String adminRoleId = roleIdByCode(Roles.ADMIN);
+        client.put()
+                .uri(ROLES + "/" + adminRoleId)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("enabled", false))
+                .exchange()
+                .expectStatus()
+                .isEqualTo(409)
+                .expectBody()
+                .jsonPath("$.message")
+                .isEqualTo("内置管理员角色不能停用");
+
+        assertThat(auditRows(adminId, "role.disable", adminRoleId, "DENIED")).isEqualTo(1);
+        assertThat(roleEnabled(adminRoleId)).isTrue();
+    }
+
+    @Test
+    void renamingTheBuiltInAdminIsAllowed() {
+        String adminRoleId = roleIdByCode(Roles.ADMIN);
+        client.put()
+                .uri(ROLES + "/" + adminRoleId)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("name", "超级管理员"))
+                .exchange()
+                .expectStatus()
+                .isOk()
+                .expectBody()
+                .jsonPath("$.builtIn")
+                .isEqualTo(true)
+                .jsonPath("$.name")
+                .isEqualTo("超级管理员");
+    }
+
+    @Test
+    void aStudentCannotManageRoles() {
+        String username = unique("student");
+        AppUser student =
+                users.insert(username, passwordEncoder.encode(PASSWORD), "Student", Roles.STUDENT).block();
+        access.assignRoleByCode(student.id(), Roles.STUDENT).block();
+        String token = TestAuth.login(client, username, PASSWORD);
+
+        client.get()
+                .uri(ROLES)
+                .header(HttpHeaders.AUTHORIZATION, "Bearer " + token)
+                .exchange()
+                .expectStatus()
+                .isForbidden();
+
+        client.post()
+                .uri(ROLES)
+                .header(HttpHeaders.AUTHORIZATION, "Bearer " + token)
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("code", unique("nope"), "name", "无权限"))
+                .exchange()
+                .expectStatus()
+                .isForbidden();
+    }
+
+    // --- helpers ----------------------------------------------------------------------------
+
+    private String bearer() {
+        return "Bearer " + adminToken;
+    }
+
+    /** Creates a role through the API and returns its code. */
+    private String createRole(String name, String parentId) {
+        String code = unique("role");
+        Map<String, Object> body = new java.util.HashMap<>();
+        body.put("code", code);
+        body.put("name", name);
+        if (parentId != null) {
+            body.put("parentId", parentId);
+        }
+        client.post()
+                .uri(ROLES)
+                .header(HttpHeaders.AUTHORIZATION, bearer())
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(body)
+                .exchange()
+                .expectStatus()
+                .isCreated();
+        return code;
+    }
+
+    private String roleIdByCode(String code) {
+        String id =
+                db.sql("SELECT id FROM access_role WHERE code = :code")
+                        .bind("code", code)
+                        .map((row, meta) -> row.get("id", String.class))
+                        .one()
+                        .block();
+        assertThat(id).as("role " + code).isNotNull();
+        return id;
+    }
+
+    private boolean roleEnabled(String roleId) {
+        Boolean enabled =
+                db.sql("SELECT enabled FROM access_role WHERE id = :id")
+                        .bind("id", roleId)
+                        .map((row, meta) -> Boolean.TRUE.equals(row.get("enabled", Boolean.class)))
+                        .one()
+                        .block();
+        return Boolean.TRUE.equals(enabled);
+    }
+
+    /** Counts audit rows matching the actor/action/result, with an optional entity id. */
+    private long auditRows(String actorId, String action, String entityId, String result) {
+        String sql =
+                "SELECT COUNT(*) AS n FROM access_audit"
+                        + " WHERE actor_id = :actorId AND action = :action AND result = :result"
+                        + (entityId == null ? "" : " AND entity_id = :entityId");
+        DatabaseClient.GenericExecuteSpec spec =
+                db.sql(sql)
+                        .bind("actorId", actorId)
+                        .bind("action", action)
+                        .bind("result", result);
+        if (entityId != null) {
+            spec = spec.bind("entityId", entityId);
+        }
+        Long count =
+                spec.map((row, meta) -> row.get("n", Long.class)).one().block();
+        return count == null ? 0L : count;
+    }
+
+    private static String readId(String json) {
+        try {
+            return new com.fasterxml.jackson.databind.ObjectMapper().readTree(json).get("id").asText();
+        } catch (Exception ex) {
+            throw new IllegalStateException("Failed to parse role id", ex);
+        }
+    }
+
+    /** A unique, pattern-valid code (lowercase start, then alphanumerics). */
+    private static String unique(String prefix) {
+        return prefix + UUID.randomUUID().toString().replace("-", "").substring(0, 10);
+    }
+}
