diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessAuditPageView.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessAuditPageView.java
new file mode 100644
index 0000000..1495d5b
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessAuditPageView.java
@@ -0,0 +1,20 @@
+package com.nekocong.text2sql.access.api.dto;
+
+import java.util.List;
+
+/**
+ * A page of the access-control audit trail: the entries for one page plus the total count matching
+ * the filters.
+ *
+ * @param items the entries on this page, ordered newest first
+ * @param total the total number of entries matching the filters (across all pages)
+ * @param page the zero-based page number
+ * @param size the effective page size (the requested size capped at the service maximum)
+ */
+public record AccessAuditPageView(List<AccessAuditView> items, long total, int page, int size) {
+
+    /** Normalizes the item list so the page is structurally immutable. */
+    public AccessAuditPageView {
+        items = items == null ? List.of() : List.copyOf(items);
+    }
+}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessAuditView.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessAuditView.java
new file mode 100644
index 0000000..a729498
--- /dev/null
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/access/api/dto/AccessAuditView.java
@@ -0,0 +1,35 @@
+package com.nekocong.text2sql.access.api.dto;
+
+/**
+ * One access-control audit entry as returned to admin clients.
+ *
+ * <p>{@code before}/{@code after} are the stored JSON payloads parsed back to JSON values (an object,
+ * an array, a scalar, or {@code null}). A malformed stored payload — which the writers never produce,
+ * but a manual edit or migration could — is returned as its raw string rather than failing the read;
+ * this is deliberate, so a single bad row cannot break the whole page.
+ *
+ * <p>Deliberately free of password material: the writers store only projections of the affected
+ * entity, never hashes or tokens.
+ *
+ * @param id the row id
+ * @param actorId the acting user id
+ * @param action the action key
+ * @param entityType the entity type
+ * @param entityId the affected id, or {@code null}
+ * @param before the parsed before state, or {@code null}
+ * @param after the parsed after state, or {@code null}
+ * @param result {@code SUCCESS} or {@code DENIED}
+ * @param reason the human-readable reason, or {@code null}
+ * @param createdAt the record time (epoch millis)
+ */
+public record AccessAuditView(
+        String id,
+        String actorId,
+        String action,
+        String entityType,
+        String entityId,
+        Object before,
+        Object after,
+        String result,
+        String reason,
+        long createdAt) {}
diff --git a/text2sql-backend/src/main/java/com/nekocong/text2sql/config/SecurityConfig.java b/text2sql-backend/src/main/java/com/nekocong/text2sql/config/SecurityConfig.java
index 01e9b5c..7722c6d 100644
--- a/text2sql-backend/src/main/java/com/nekocong/text2sql/config/SecurityConfig.java
+++ b/text2sql-backend/src/main/java/com/nekocong/text2sql/config/SecurityConfig.java
@@ -102,20 +102,28 @@ public class SecurityConfig {
                                         // access.manage rule below.
                                         .pathMatchers(
                                                 HttpMethod.GET,
                                                 "/api/admin/access-control/users",
                                                 "/api/admin/access-control/users/*")
                                         .access(userRead())
                                         .pathMatchers(
                                                 "/api/admin/access-control/users",
                                                 "/api/admin/access-control/users/**")
                                         .access(userManage())
+                                        // The audit trail is read-only and gated by audit.read, not
+                                        // access.manage, so an auditor can review changes without
+                                        // being able to make them. Must precede the generic
+                                        // /api/admin/** access.manage rule below.
+                                        .pathMatchers(
+                                                HttpMethod.GET,
+                                                "/api/admin/access-control/audit")
+                                        .access(auditRead())
                                         .pathMatchers("/api/admin/**")
                                         .access(accessManage())
                                         // The three knowledge collections, their documents and the
                                         // retrieval debug endpoints require the access-management
                                         // permission.
                                         // The legacy in-memory API stays open to any authenticated
                                         // caller for backwards compatibility.
                                         .pathMatchers("/api/text2sql/knowledge/legacy/**")
                                         .authenticated()
                                         .pathMatchers("/api/text2sql/knowledge/**")
@@ -171,20 +179,29 @@ public class SecurityConfig {
 
     /**
      * Requires the {@code user.manage} permission (user create/status/reset/roles/display-name).
      *
      * @return the authorization manager
      */
     static ReactiveAuthorizationManager<AuthorizationContext> userManage() {
         return PermissionAuthorizationManager.permission(Permissions.USER_MANAGE);
     }
 
+    /**
+     * Requires the {@code audit.read} permission (read-only audit-trail access).
+     *
+     * @return the authorization manager
+     */
+    static ReactiveAuthorizationManager<AuthorizationContext> auditRead() {
+        return PermissionAuthorizationManager.permission(Permissions.AUDIT_READ);
+    }
+
     /**
      * Maps the JWT {@code role} claim to a single granted authority.
      *
      * <p>An unknown or missing role maps to {@code ROLE_NONE}: the caller stays authenticated but
      * carries no role authority. The data-permission layer validates the resolved scope on every
      * query, and the management routes are gated by permissions resolved from the access-control
      * tables, so this authority is informational only.
      *
      * @return the converter
      */
