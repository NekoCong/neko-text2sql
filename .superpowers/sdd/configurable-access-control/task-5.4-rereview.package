+    private String displayNameOf(String id) {
+        String value =
+                db.sql("SELECT COALESCE(display_name, '') AS dn FROM app_user WHERE id = :id")
+                        .bind("id", id)
+                        .map((row, meta) -> row.get("dn", String.class))
+                        .one()
+                        .block();
+        return value == null || value.isEmpty() ? null : value;
+    }
