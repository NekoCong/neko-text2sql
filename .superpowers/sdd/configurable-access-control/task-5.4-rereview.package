+                .bodyValue(Map.of("password", "newsecret9"))
+                .exchange()
+                .expectStatus()
+                .isForbidden();
+        client.put()
+                .uri(USERS + "/" + user.id() + "/roles")
+                .header(HttpHeaders.AUTHORIZATION, token)
+                .contentType(MediaType.APPLICATION_JSON)
+                .bodyValue(Map.of("roleIds", List.of(roleIdByCode(Roles.STUDENT))))
