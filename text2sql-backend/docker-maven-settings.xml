<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings used only inside the Docker build.

  This deployment runs on a mainland-China host where repo.maven.apache.org is reachable but very
  slow (single-digit kB/s), so the build resolves artifacts through the Aliyun public mirror.
  Outside that network, delete the COPY line in the Dockerfile and Maven Central is used again.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <mirrors>
        <mirror>
            <id>aliyun-public</id>
            <name>Aliyun public repository</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
    </mirrors>
</settings>
